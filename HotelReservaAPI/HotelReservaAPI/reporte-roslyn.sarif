                "executionTimeInPercentage": "<1"
              }
            },
            {
              "id": "ASP0015",
              "shortDescription": {
                "text": "Suggest using IHeaderDictionary properties"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://aka.ms/aspnet/analyzers",
              "properties": {
                "category": "Usage",
                "executionTimeInSeconds": "<0.001",
